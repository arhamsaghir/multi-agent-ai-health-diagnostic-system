    <style>
        .govbar-tooltip{position:relative}
        .govbar-tooltip::after{content:attr(data-tooltip);position:absolute;top:calc(100% + 8px);right:0;width:190px;background:#fffbe6;color:#1a2332;font-size:12px;line-height:1.4;font-weight:600;padding:8px 10px;border:1px solid #f0d97a;border-radius:6px;box-shadow:0 4px 14px rgba(0,0,0,.18);opacity:0;visibility:hidden;transition:opacity .15s,visibility .15s;z-index:1000;text-align:center}
        .govbar-tooltip::before{content:'';position:absolute;top:100%;right:16px;border:6px solid transparent;border-bottom-color:#fffbe6;opacity:0;visibility:hidden;transition:opacity .15s,visibility .15s;z-index:1001}
        .govbar-tooltip:hover::after,.govbar-tooltip:hover::before{opacity:1;visibility:visible}
        .page-utility-bar{display:flex;justify-content:flex-end;align-items:center;gap:10px;padding:6px 24px;font-size:13px;background:#fff;border-bottom:1px solid #e5eaf1}
        .page-utility-bar a{color:#0b5595;text-decoration:none;display:inline-flex;align-items:center;gap:4px}
        .page-utility-bar a:hover{text-decoration:underline}
        .page-utility-sep{color:#c3cede}
        /* Bhashini language widget in the gov bar: make only the trigger button visible on the dark navy background */
        .govbar-right .bhashini-plugin-container{display:flex;align-items:center;min-width:28px;height:100%}
        .govbar-right .bhashini-dropdown-btn,
        .govbar-right .bhashini-dropdown-btn *{color:#fff !important;fill:#fff}
        .govbar-right .bhashini-dropdown-btn img,
        .govbar-right .bhashini-dropdown-btn svg{filter:brightness(0) invert(1);max-height:22px;width:auto}
        .govbar-right .bhashini-dropdown-content,
        .govbar-right .bhashini-dropdown-content *{color:#102a4c !important}
    </style>
</head>
