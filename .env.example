# OpenAI API (GPT-4o-mini + Whisper)
OPENAI_API_KEY=your_openai_api_key_here

# Google AI Studio (Gemini 1.5 Flash)
GOOGLE_API_KEY=your_google_api_key_here

# NVIDIA NIM (Nemotron 3 Super Free)
NVIDIA_API_KEY=your_nvidia_api_key_here

# HuggingFace (BioBERT downloads — optional)
HF_TOKEN=your_huggingface_token_here

# Application Settings
APP_ENV=development
LOG_LEVEL=debug
SECRET_KEY=change_this_to_a_random_string

# Database
DATABASE_URL=sqlite:///./data/diagnostic.db

# Vector Store
VECTOR_STORE_DIR=./data/vector_store

# Model Paths
VISION_MODEL_PATH=./models/vision_resnet50.pth
PREDICTION_MODEL_PATH=./models/prediction_xgboost.pkl
