# OpenAI API (GPT-4o-mini + Whisper)
OPENAI_API_KEY=your_openai_api_key_here

# Google AI Studio (Gemini 1.5 Flash)
GOOGLE_API_KEY=your_google_api_key_here

# NVIDIA NIM (Nemotron 3 Super Free)
NVIDIA_API_KEY=your_nvidia_api_key_here

# HuggingFace (optional biomedical NER checkpoint — only if ENABLE_BIOBERT_NER=true)
HF_TOKEN=your_huggingface_token_here

# Application Settings
APP_ENV=development
LOG_LEVEL=debug

# Service API key for the clinical API. Required outside development.
SECRET_KEY=change_this_to_a_random_string

# Require X-API-Key on every non-public endpoint (always on outside development).
ENFORCE_API_KEY=true

# Development-only bypass of the API key check. Set to false to require the
# key even while APP_ENV=development.
ALLOW_INSECURE_DEV=true

# NLP: the deterministic clinical-pattern extractor is the default path.
# Enable to additionally run a biomedical NER checkpoint.
ENABLE_BIOBERT_NER=false
BIOBERT_MODEL_ID=d4data/biomedical-ner-all

# Database
DATABASE_URL=sqlite:///./data/diagnostic.db

# Vector Store
VECTOR_STORE_DIR=./data/vector_store

# Model Paths
VISION_MODEL_PATH=./models/vision_resnet50.pth
PREDICTION_MODEL_PATH=./models/prediction_xgboost.pkl
